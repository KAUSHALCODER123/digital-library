# Supabase (Project Settings -> API). The anon/publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://gmymjffflptswthiszac.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Optional, but raises the Google Books quota. Never prefix with NEXT_PUBLIC_.
GOOGLE_BOOKS_API_KEY=

# Canonical site URL, used for metadata, sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to serve book data from local fixtures (used by the Playwright suite).
BOOKS_MOCK=
